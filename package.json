    "context-engineering",
    "ai-agents",
    "developer-tools",
    "cli",
    "local-first",
    "memory-layer",
    "agent-hooks",
    "ai-coding-assistant",
    "multi-machine-sync",
    "prompt-engineering",
    "zero-dependencies",
    "nodejs"
  ],
  "license": "MIT",
